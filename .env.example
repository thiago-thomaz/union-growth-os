# UNION GROWTH OS — Environment Configuration Example
# Never commit real secrets to version control.

APP_NAME="UNION GROWTH OS"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG="false"

# Database (PostgreSQL in production, SQLite fallback in development)
DATABASE_URL="sqlite:///./data/union_growth_os.db"
# Example Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://union_user:CHANGE_ME@postgres:5432/union_growth_os"

# Security Keys (Generate strong 32+ byte keys in production)
SECRET_KEY="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
JWT_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
# Fernet 32-byte URL-safe base64 key for encrypting third-party OAuth/API tokens
ENCRYPTION_KEY="CHANGE_ME_FERNET_BASE64_KEY_32_BYTES"

# Public URLs
PUBLIC_URL="https://uniongrowth.72.62.13.62.sslip.io"
CUSTOM_DOMAIN_URL="https://growth.projetosunion.cloud"
CORS_ORIGINS="*"

# Optional AI Providers (System works 100% deterministically + local fallback without paid keys)
AI_DEFAULT_PROVIDER="deterministic"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""

# Optional Official Platform Integrations (Managed per-tenant in encrypted database vault)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PAGESPEED_API_KEY=""
BING_WEBMASTER_API_KEY=""
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
MERCADOPAGO_ACCESS_TOKEN=""

# Email / SMTP Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@projetosunion.cloud"
SMTP_USE_TLS="true"

# Scheduler & Backup
SCHEDULER_ENABLED="true"
BACKUP_DIR="./data/backups"
ASSETS_DIR="./data/assets"
DATA_RETENTION_DAYS="365"
RATE_LIMIT_PER_MINUTE="120"

